# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Ticketmaster Discovery API: developer.ticketmaster.com → My Apps → Consumer Key
TICKETMASTER_API_KEY=

# Supabase: Project Settings → API Keys. The URL and publishable key are public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server-only, bypasses row level security.
SUPABASE_SECRET_KEY=

# Spotify user ID of the site owner (spotify.com/account/overview → Username).
OWNER_SPOTIFY_ID=

# Spotify app: developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared secret Vercel Cron sends to /api/cron/refresh. Any long random string,
# e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Last.fm (last.fm/api/account/create → API key) supplies the US's most
# listened-to artists for the Popular page. Server-only.
LASTFM_API_KEY=

# Resend (resend.com → API Keys) sends the reminder emails. Server-only.
RESEND_API_KEY=
# Where reminders go. Must be the email the Resend account was made with.
REMINDER_EMAIL=
