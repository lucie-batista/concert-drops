# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Ticketmaster Discovery API: developer.ticketmaster.com → My Apps → Consumer Key
TICKETMASTER_API_KEY=

# Supabase: Project Settings → API Keys. The URL and publishable key are public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server-only, bypasses row level security.
SUPABASE_SECRET_KEY=

# Spotify user ID of the site owner (spotify.com/account/overview → Username).
OWNER_SPOTIFY_ID=

# Spotify app: developer.spotify.com/dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
